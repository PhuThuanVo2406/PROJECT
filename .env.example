# Copy to .env.local for local development, and add the same two values
# in Vercel > Project > Settings > Environment Variables.
# Both come from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only students with this email domain can sign up. The database enforces the
# same rule (see supabase/migrations), so change both if HCC's domain differs.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=student.hccs.edu
