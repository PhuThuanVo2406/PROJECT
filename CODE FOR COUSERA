import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
import seaborn as sns
from sklearn.linear_model import LinearRegression
%matplotlib inline

# ======================
# LOADING DATA
# ======================
file = 'https://cf-courses-data.s3.us.cloud-object-storage.appdomain.cloud/IBMDeveloperSkillsNetwork-DA0101EN-SkillsNetwork/labs/FinalModule_Coursera/data/kc_house_data_NaN.csv'
df = pd.read_csv(file)

# ======================
# QUESTION 1
# ======================
df.describe()

# ======================
# QUESTION 2
#   - Drop 'id' and 'Unnamed: 0'
#   - Check and impute NaNs in bedrooms/bathrooms (NO chained assignment)
# ======================
df.drop(["id", "Unnamed: 0"], axis=1, inplace=True)

print("NaNs before fill:")
print("bedrooms :", df['bedrooms'].isnull().sum())
print("bathrooms:", df['bathrooms'].isnull().sum())

# Fill with column means (avoid chained assignment warnings)
df[['bedrooms', 'bathrooms']] = df[['bedrooms', 'bathrooms']].fillna(
    df[['bedrooms', 'bathrooms']].mean()
)

print("NaNs after fill:")
print("bedrooms :", df['bedrooms'].isnull().sum())
print("bathrooms:", df['bathrooms'].isnull().sum())

df.describe()

